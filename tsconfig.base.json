{
  // tsc only type-checks; esbuild bundles the TypeScript sources (see the `package` scripts).
  // https://www.typescriptlang.org/docs/handbook/modules/reference.html#preserve
  "compilerOptions": {
    // resolve and check imports the way esbuild does: implies "moduleResolution": "bundler",
    // "esModuleInterop" and "resolveJsonModule"
    "module": "preserve",
    // implied by "preserve", but ts-jest compiles the tests with "module": "commonjs", where it is not:
    // without it, `import path from 'path'` gives undefined in tests
    "esModuleInterop": true,
    // esbuild compiles each file on its own, forbid what it can't compile correctly
    "isolatedModules": true,
    "noEmit": true,
    "target": "es2022",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
