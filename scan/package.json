{
  "name": "@qodana/action",
  "version": "1.0.0",
  "private": true,
  "author": "JetBrains",
  "license": "Apache-2.0",
  "main": "lib/main.js",
  "scripts": {
    "lint": "prettier --write '**/*.ts' && eslint --fix **/*.ts -c ../.github/linters/.eslintrc.yml",
    "build": "tsc --build .",
    "package": "esbuild src/main.ts --platform=node --format=cjs --keep-names --bundle --outfile=dist/index.js",
    "test": "jest --config jest.config.js",
    "readme": "cp ../.github/md/github.md ../README.md && curl -sS https://raw.githubusercontent.com/JetBrains/Qodana/2026.3/topics/github.md >> ../README.md && cat ../.github/md/tracker.md >> ../README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JetBrains/qodana-action.git"
  },
  "dependencies": {
    "@actions/artifact": "^2.3.2",
    "@actions/cache": "^4.1.0",
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.0",
    "@actions/github": "^6.0.1",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.2"
  },
  "devDependencies": {
    "@types/sarif": "^2.1.7"
  }
}
