{
  "name": "@qodana/ci",
  "version": "1.0.0",
  "private": true,
  "description": "Common code for Qodana Scan GitHub action and Qodana Azure Pipelines extension.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JetBrains/qodana-cli.git"
  },
  "scripts": {
    "lint": "eslint --fix . && prettier --write \"**/*.ts\"",
    "typecheck": "tsc -p common && tsc -p scan && tsc -p vsts && tsc -p gitlab",
    "test": "npm run test --workspaces",
    "package": "npm run -w scan package && npm run -w vsts package && npm run -w gitlab package",
    "all": "npm run lint && npm run typecheck && npm run test && npm run package",
    "prepare": "husky"
  },
  "contributors": [
    {
      "name": "Viktor Tiulpin",
      "url": "https://github.com/tiulpin"
    },
    {
      "name": "Andrei Iurko",
      "url": "https://github.com/AndreiIurko"
    }
  ],
  "workspaces": [
    "common",
    "scan",
    "vsts",
    "gitlab"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "esbuild": "0.28.0",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "prettier": "3.8.1",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
